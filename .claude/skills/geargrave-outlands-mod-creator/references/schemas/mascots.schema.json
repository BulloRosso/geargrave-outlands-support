{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/BulloRosso/geargrave-outlands-support/main/.claude/skills/geargrave-outlands-mod-creator/references/schemas/mascots.schema.json",
  "title": "mascots.json — mascots (existing effectIds only)",
  "description": "GENERATED from the game's loader types — do not edit. // comments allowed. NO trailing commas. Keys are matched case-insensitively by the game; write them in camelCase.",
  "$ref": "#/$defs/FileShape",
  "$defs": {
    "MascotDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "cult": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "effectId": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        },
        "image": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^(\\$schema|_.*|comment|comments)$": {}
      },
      "additionalProperties": false
    },
    "FileShape": {
      "type": "object",
      "properties": {
        "mascots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MascotDef"
          }
        }
      },
      "patternProperties": {
        "^(\\$schema|_.*|comment|comments)$": {}
      },
      "additionalProperties": false
    }
  }
}
