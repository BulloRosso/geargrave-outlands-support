{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/BulloRosso/geargrave-outlands-support/main/.claude/skills/geargrave-outlands-mod-creator/references/schemas/audio.schema.json",
  "title": "audio.json — sound effects (events) and music playlists",
  "description": "GENERATED from the game's loader types — do not edit. // comments allowed. Trailing commas allowed. Keys are matched case-insensitively by the game; write them in camelCase.",
  "$ref": "#/$defs/AudioConfig",
  "$defs": {
    "AudioConfig": {
      "type": "object",
      "properties": {
        "playlists": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "description": "custom format (see file-reference.md)"
            }
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "patternProperties": {
        "^(\\$schema|_.*|comment|comments)$": {}
      },
      "additionalProperties": false
    }
  }
}
