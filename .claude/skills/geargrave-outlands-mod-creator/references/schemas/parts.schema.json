{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/BulloRosso/geargrave-outlands-support/main/.claude/skills/geargrave-outlands-mod-creator/references/schemas/parts.schema.json",
  "title": "parts.json — parts / items",
  "description": "GENERATED from the game's loader types — do not edit. // comments allowed. NO trailing commas. Keys are matched case-insensitively by the game; write them in camelCase.",
  "$ref": "#/$defs/FileShape",
  "$defs": {
    "PartStory": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "lore": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "loreKey": {
          "type": "string"
        },
        "hintKey": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^(\\$schema|_.*|comment|comments)$": {}
      },
      "additionalProperties": false
    },
    "PartLiving": {
      "type": "object",
      "properties": {
        "eats": {
          "type": "string"
        },
        "perDay": {
          "type": "integer"
        },
        "unfedDays": {
          "type": "integer"
        },
        "fate": {
          "type": "string"
        },
        "everyDays": {
          "type": "integer"
        }
      },
      "patternProperties": {
        "^(\\$schema|_.*|comment|comments)$": {}
      },
      "additionalProperties": false
    },
    "PartDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "Engine",
            "Cargo"
          ]
        },
        "quality": {
          "enum": [
            "Small",
            "Medium",
            "Large"
          ]
        },
        "class": {
          "enum": [
            "None",
            "Defense",
            "Prep",
            "Base",
            "LootBox"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "weightKg": {
          "type": "integer"
        },
        "electric": {
          "type": "boolean"
        },
        "carry": {
          "type": "string"
        },
        "set": {
          "type": "string"
        },
        "story": {
          "$ref": "#/$defs/PartStory"
        },
        "living": {
          "$ref": "#/$defs/PartLiving"
        },
        "fragile": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxCopies": {
          "type": "integer"
        },
        "sellable": {
          "type": "boolean"
        }
      },
      "patternProperties": {
        "^(\\$schema|_.*|comment|comments)$": {}
      },
      "additionalProperties": false
    },
    "FileShape": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartDef"
          }
        }
      },
      "patternProperties": {
        "^(\\$schema|_.*|comment|comments)$": {}
      },
      "additionalProperties": false
    }
  }
}
